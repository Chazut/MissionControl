<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <AssemblyName>MissionControl</AssemblyName>
    <Version>1.2.0</Version>
    <RootNamespace>MissionControl</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <SPT_DIR>C:\Games\SPT-4.1\SPT_Runtime</SPT_DIR>
  </PropertyGroup>

  <!-- Copy config folder into Release output -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <None Include="..\..\config\**\*.*">
      <Link>config\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>config\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>

  <!-- SPT 4.1 server references -->
  <ItemGroup Condition="'$(SPT_DIR)' != ''">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="SPTarkov.Server.Web" HintPath="$(SPT_DIR)\SPTarkov.Server.Web.dll" Private="false" />
    <EmbeddedResource Include="../../branding/mission-control.svg" LogicalName="MissionControl.Emblem.svg" />
    <EmbeddedResource Include="../../config/config.jsonc" LogicalName="MissionControl.DefaultConfig.jsonc" />
    <EmbeddedResource Include="Web/Settings.css" LogicalName="MissionControl.Settings.css" />
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>$(SPT_DIR)\SPTarkov.Server.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>$(SPT_DIR)\SPTarkov.DI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Common">
      <HintPath>$(SPT_DIR)\SPTarkov.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPT.Server">
      <HintPath>$(SPT_DIR)\SPT.Server.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SemanticVersioning">
      <HintPath>$(SPT_DIR)\SemanticVersioning.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="EnsureSptDirProvided" BeforeTargets="Build">
    <Error Condition="'$(SPT_DIR)' == ''" Text="SPT_DIR must be set (path to SPT server DLLs) to build this project." />
  </Target>

  <!-- Deploy mod to SPT after build -->
  <PropertyGroup>
    <ModDeployDir>$(SPT_DIR)\user\mods\MissionControl</ModDeployDir>
  </PropertyGroup>

  <Target Name="DeployMod" AfterTargets="Build" Condition="Exists('$(ModDeployDir)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModDeployDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="[MissionControl] Deployed DLL to $(ModDeployDir)" />
  </Target>

  <Target Name="DeployModAssets" AfterTargets="Build" Condition="Exists('$(ModDeployDir)')">
    <ItemGroup>
      <ConfigFiles Include="..\..\config\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="%(ConfigFiles.FullPath)" DestinationFiles="$(ModDeployDir)\config\%(ConfigFiles.RecursiveDir)%(ConfigFiles.Filename)%(ConfigFiles.Extension)"
          Condition="!Exists('$(ModDeployDir)\config\%(ConfigFiles.RecursiveDir)%(ConfigFiles.Filename)%(ConfigFiles.Extension)')" />
  </Target>
</Project>
